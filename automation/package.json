{
  "name": "kolvex-whatsapp-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "robot": "node --env-file-if-exists=.env playwright-runner.js",
    "robot:simulate": "node --env-file-if-exists=.env playwright-runner.js --simulate",
    "test:browser": "node --test browser.test.js",
    "start": "node --env-file-if-exists=.env playwright-runner.js",
    "simulate": "node --env-file-if-exists=.env playwright-runner.js --simulate",
    "worker": "node --env-file-if-exists=.env worker.js",
    "worker:simulate": "node --env-file-if-exists=.env worker.js --simulate"
  },
  "overrides": { "puppeteer": "25.15.0" },
  "dependencies": {
    "playwright": "1.64.1",
    "whatsapp-web.js": "1.34.7",
    "qrcode-terminal": "0.12.0"
  }
}
