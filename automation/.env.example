# CRM local o instalación remota HTTPS. Usuario administrador existente.
CRM_URL=http://127.0.0.1:3000
CRM_EMAIL=
CRM_PASSWORD=
# Carpeta persistente, relativa a automation/ o absoluta.
WA_SESSION_DIR=.session
# Opcional: ruta de Chrome/Chromium; si queda vacía se usa Chrome instalado.
WA_CHROME_PATH=
# Robot por pantalla: chrome (predeterminado) o msedge.
WA_BROWSER_CHANNEL=chrome
# Opcionales si WhatsApp cambia el diseño de su interfaz.
WA_COMPOSER_SELECTOR=
WA_SEND_SELECTOR=
