# Copia este archivo como .env y completa los valores.

# Puerto donde escucha el servidor
PORT=3000

# Clave para firmar las sesiones. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Primer administrador (solo se usa la primera vez que arranca, con la base vacía)
ADMIN_NAME=Matías
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Días que dura una sesión antes de pedir login de nuevo
SESSION_DAYS=14

# Zona horaria (para "seguimientos vencidos")
TZ=America/Asuncion
